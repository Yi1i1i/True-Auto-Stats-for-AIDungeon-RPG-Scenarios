// Checks if target words appear consecutively in words at startIndex
function MatchesWordSequence(words, startIndex, targetWords, includePlural = false) {
  return targetWords.every((word, j) => {
    let inputWord = words[startIndex + j]?.toLowerCase();
    let targetWord = word.toLowerCase();

    // Check for an exact match
    if (inputWord === targetWord) {
      return true;
    }

    // Check for plural matches if enabled
    if (includePlural) {
      return (
        inputWord === targetWord + "s" ||
        inputWord === targetWord + "es" ||
        inputWord === targetWord.slice(0, -1) + "ies"
      );
    }

    return false;
  });
}

// Loop through arr until match is found in string.
function ContainsTargets(str, targetsArr) {
  let words = RemovePunctuation(str).toLowerCase().split(" ");

  for (let target of targetsArr) {
    let targetWords = RemovePunctuation(target).toLowerCase().split(" ");

    for (let i = 0; i < words.length; i++) {
      if (MatchesWordSequence(words, i, targetWords)) {
        return true;
      }
    }
  }

  return false;
}

// Checks to see if target words are found in the input and if it trails a pronoun
function TriggerCheck(text, targetWordsArr, x) {
  if (!text || !targetWordsArr || targetWordsArr.length === 0) {
    return false;
  }

  // Remove punctuation and split text into words
  let cleanText = RemovePunctuation(text).toLowerCase();
  let inputWords = cleanText.split(/\s+/).filter(word => word.length > 0);

  // Loop through each word in the input text
  for (let i = 0; i < inputWords.length; i++) {
    // Check if current input word matches any target word(s)
    let isTarget = targetWordsArr.some(target => {
      // Multi target word compatible
      let targetWords = target.toLowerCase().split(/\s+/);

      return targetWords.every((word, j) => {
        let inputWord = inputWords[i + j];
        return inputWord === word || inputWord === word + "s" ||
          inputWord === word + "es" ||
          inputWord === word.slice(0, -1) + "ies";
      });
    });

    // If input word matches target, check previous words for pronouns or 'and'
    if (isTarget) {
      // Check the x words before the target
      let startIndex = Math.max(0, i - x);
      let wordsBefore = inputWords.slice(startIndex, i);

      // Return true if 'you' or 'and' appears before the target
      if (wordsBefore.includes("you") || wordsBefore.includes("and")) {
        return true;
      }

      // Return true if player name appears before target
      let playerNames = GetPlayerList().map(name => name.toLowerCase());
      if (playerNames.some(name =>
        (` ${wordsBefore.join(" ")} `).includes(` ${name} `)
      )) {
        return true;
      }
    }
  }

  return false;
}

function FindStoryCard(title) {
  return storyCards.find(sc => sc.title === title);
}

function AddSCDescription(title, logText) {
  let sc = FindStoryCard(title);
  if (sc) {
    sc.description = logText + "\n" + sc.description;
  }
}

function TrimSCDescription(sc, maxChar) {
  if (sc && sc.description && sc.description.length > maxChar) {
    sc.description = sc.description.slice(0, maxChar / 2);

    log(`Trimming ${sc.title} description to prevent memory overload.`);
  }
}

// Round number to x places, returns number
function RoundFloat(num, places) {
  if (num == null) return num;
  if (Number.isInteger(num)) return num;

  let multiplier = 10 ** places;
  return Math.round((num + Number.EPSILON) * multiplier) / multiplier;
}


