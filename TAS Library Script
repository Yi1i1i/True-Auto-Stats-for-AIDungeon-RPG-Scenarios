// Translate number level to english tier phrase
function GetEnglishTier(number) {
  if (number == null || isNaN(number)) {
    log("GetEnglishTier error: Invalid number " + number);
    return "Unknown tier";
  }

  if (number < 0) {
    return "Negative level";
  }

  let tier = Math.floor(number / 10);

  if (tier < tierLabels.length) {
    return tierLabels[tier];
  }

  return tierLabels[tierLabels.length - 1];
}

// Get percentage and translate to english capacity phrase
function GetEnglishCapacity(part, whole) {
  if (part == null || whole == null || isNaN(part) || isNaN(whole) || whole <= 0) {
    log(`GetEnglishCapacity error: Invalid values (part: ${part}, whole: ${whole})`);
    return "Unknown Capacity";
  }

  if (part < 0) {
    return "Below Empty";
  }

  let percentage = (part / whole) * 100;
  let tier = Math.floor(percentage / 10);

  if (tier < 0) {
    return "Below Empty";
  }

  return capacityTier[Math.min(tier, capacityTier.length - 1)];
}

