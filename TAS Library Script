// RETRIEVE skills from SC
function RetrieveSkillsFromSC() {
  GetPlayerList().forEach(plr => {
    // Fetch skill SC
    let skillSC = FindStoryCard(`${plr} Skills`);
    if (!skillSC || !skillSC.entry) {
      log(`Skill story card not found for ${plr}.`);
      return;
    }

    // Keep existing player skills
    let plrSkills = state.players[plr].skills;
    let retrievedSkills = [];
    let newSkills = [];

    // Extract skill name, level, cost, and optional ID
    let regex = /^(.+?)\s*\([^)]*?(-?\d+(?:\.\d+)?)[^)]*\)\s*\([^)]*?(-?\d+(?:\.\d+)?)[^)]*\)(?:\s*<([^>]+)>)?$/gim;
    let matches = skillSC.entry.matchAll(regex);

    for (let match of matches) {
      // Save match data
      let name = match[1].trim();
      let lvl = Number(match[2]) || 0;
      let cost = Number(match[3]) || 0;
      let skillId = match[4] ? match[4].trim() : GenerateId(4);

      // Save retrieved skill ID
      retrievedSkills.push(skillId);

      // Preserve existing skill data and update retrieved fields
      if (plrSkills[skillId]) {
        plrSkills[skillId].name = name;
        plrSkills[skillId].lvl = lvl;
        plrSkills[skillId].cost = cost;
      }
      // Newly retrieved skill
      else {
        while (skillId in plrSkills) {
          skillId = GenerateId(4);
        }

        newSkills.push(skillId);
        plrSkills[skillId] = { name, lvl, cost, tier: 0 };
      }
    }

    // Remove skills that no longer exist in the story card
    Object.keys(plrSkills).forEach(skillId => {
      if (
        !retrievedSkills.includes(skillId) &&
        !newSkills.includes(skillId)
      ) {
        delete plrSkills[skillId];
      }
    });

    //log(JSON.stringify(Object.entries(plrSkills), null, 2));
  });
}

