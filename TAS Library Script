// Function to detect when the player attempts to dodge
function ProcessDodge(text) {
  // Skip text that is dialogue
  if (DialogueChecker(text)) {
    return text;
  }

  // Split text into sentences
  let sentences = SplitToSentences(text);
  if (sentences.length === 0) {
    //log("No text found: " + text);
    return text;
  }

  // Loop through each sentence
  for (let i = 0; i < sentences.length; i++) {
    let sentence = sentences[i];

    // Get current player in sentence
    let plr = GetPlayerInString(sentence);
    if (!plr) {
      //log("No player found in sentence: " + sentence);
      continue;
    }
    //log("Player found: " + plr);

    // Check if dodge is requested
    let startDodge = TriggerCheck(sentence, dodgeWords, 3);
    if (!startDodge) {
      continue;
    }
    log("startDodge: " + startDodge);

    // Define SPD stat ranges
    const spdRanges = [
      { tier: 1, min: 0, max: 10 },
      { tier: 2, min: 10, max: 20 },
      { tier: 3, min: 20, max: 30 },
      { tier: 4, min: 30, max: 40 },
      { tier: 5, min: 40, max: 50 },
      { tier: 6, min: 50, max: 60 },
      { tier: 7, min: 60, max: 70 },
      { tier: 8, min: 70, max: 80 },
      { tier: 9, min: 80, max: 90 },
      { tier: 10, min: 90, max: Infinity }
    ];

    let plrSpd = state.players[plr].stats.spd.current;
    let plrEp = state.players[plr].stats.ep.current;

    // Calculate energy requirements for dodging
    let dodgeEnergyLoss = (2 * (plrSpd / 10) + RandomInt(0, 5)) * -1;
    if (plrSpd > 100) {
      dodgeEnergyLoss = (20 + plrSpd / 25) * -1;
    }
    log("dodgeEnergyLoss: " + dodgeEnergyLoss);

    let dodgeFlavorText = "";

    // Check if player has enough energy
    let dodgeEnergyCheck = plrEp >= Math.abs(dodgeEnergyLoss) && plrEp >= 0;
    log("dodgeEnergyCheck: " + dodgeEnergyCheck);

    // CASE: NOT enough energy
    if (!dodgeEnergyCheck) {
      let msg = ` ${GetRandomArrElement(realizePhrases)} ${GetRandomArrElement(notEnoughPhrases).toLowerCase().replace("[stat]", "energy").replace("[thing]", "your movement")}`;
      msg = AutoCoOpLang(plr, msg);
      dodgeFlavorText += msg;
    }
    // CASE: Enough energy
    else {
      // Select dodge message based on SPD
      for (let range of spdRanges) {
        if (IsBetween(plrSpd, range.min, range.max)) {
          let tier = speedPhrases[range.tier];
          let msg = ` ${GetRandomArrElement(tier)}`;
          msg = AutoCoOpLang(plr, msg);
          dodgeFlavorText += msg;
          break;
        }
      }

      // Consume energy and grant SPD
      AddStat(plr, "ep", dodgeEnergyLoss);
      AddStat(plr, "spd", RandomFloat(0.01, 2));

      // Check for lucky dodge
      let dodgeLuckRoll = RandomInt(1, 100);
      log("dodgeLuckRoll: " + dodgeLuckRoll);

      let plrLck = state.players[plr].stats.lck.current;

      if (dodgeLuckRoll <= plrLck && dodgeLuckRoll >= 1) {
        let msg = ` ${GetRandomArrElement(graspPhrases)} ${GetRandomArrElement(luckyPhrases)}.`;
        msg = AutoCoOpLang(plr, msg);
        dodgeFlavorText += msg;

        // Grant luck stat
        AddStat(plr, "lck", RandomFloat(0.01, 2));
      }

      StoreStatsToSC();
    }

    // Append dodge flavor text to the sentence
    sentences[i] = sentence + dodgeFlavorText;
  }

  // Recombine sentences
  text = sentences.join(" ");
  return text;
}

