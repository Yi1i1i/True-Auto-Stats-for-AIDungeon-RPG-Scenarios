function ProcessAttack(text) {
  // Skip text that is dialogue
  if (DialogueChecker(text)) {
    return text;
  }

  // Split text into sentences
  let sentences = SplitToSentences(text);
  if (sentences.length === 0) {
    log('No text found: ' + text);
    return text;
  }

  // Loop through each sentence, process attack if triggered
  for (let i = 0; i < sentences.length; i++) {
    // Current sentence
    let sentence = sentences[i];

    // Get current player in sentence
    let plr = GetPlayerInString(sentence);
    if (!plr) {
      continue;
    }

    // Check if sentence contains pronoun and trigger words
    let attackRequested = TriggerCheck(sentence, attackWords, 3);
    if (!attackRequested) {
      continue;
    }
    log('attackRequested: ' + attackRequested);

    // Get the player's attack and speed stats
    let plrAtk = state.players[plr].stats.atk.current;
    let plrSpd = state.players[plr].stats.spd.current;
    let plrEp = state.players[plr].stats.ep.current;

    // Calculate energy requirements for attack
    let atkEnergyLoss = (2 * (plrAtk / 10) + RandomInt(0, 5)) * -1;
    if (plrAtk > 100) {
      atkEnergyLoss = (20 + plrAtk / 25) * -1;
    }
    log("Atk energy loss: " + atkEnergyLoss);

    // Check if plr has enough energy for attack
    let enoughEnergy = plrEp >= Math.abs(atkEnergyLoss) && plrEp >= 0;
    log("Enough energy for attack: " + enoughEnergy);

    // Initialize
    let attackFlavorText = "";

    // Clone sentence so modifications dont affect original
    let sentenceClone = sentence;

    // CASE: NOT enough energy to attack, append flavor text
    if (!enoughEnergy) {
      let msg = ` ${GetRandomArrElement(realizePhrases)} ${GetRandomArrElement(notEnoughPhrases).toLowerCase().replace("[stat]", "energy").replace("[thing]", "your attack")}`;
      msg = AutoCoOpLang(plr, msg);
      attackFlavorText += msg;

      sentenceClone += attackFlavorText;
    }
    // CASE: ENOUGH energy to attack, append flavor text
    else {
      // Append attack speed flavor text
      for (let range of atkSpdRanges) {
        if (IsBetween(plrSpd, range.min, range.max)) {
          let tier = attackSpeedPhrases[range.tier];
          let msg = ` ${GetRandomArrElement(tier)}`;
          msg = AutoCoOpLang(plr, msg);
          attackFlavorText += msg;
          break;
        }
      }

      // Append attack flavor text
      for (let range of atkRanges) {
        if (IsBetween(plrAtk, range.min, range.max)) {
          let tier = attackPhrases[range.tier];
          let msg = ` and ${GetRandomArrElement(tier).toLowerCase()}`;
          msg = AutoCoOpLang(plr, msg);
          attackFlavorText += msg;
          break;
        }
      }

      // Attacking grants SPD and ATK
      AddStat(plr, "spd", RandomFloat(0.01, 2), "Attack experience");
      AddStat(plr, "atk", RandomFloat(0.01, 2), "Attack experience");

      // Apply energy loss from attack
      AddStat(plr, "ep", atkEnergyLoss, 'Attack energy used');

      let plrLck = state.players[plr].stats.lck.current;

      // Roll for luck boost
      let atkLuckRoll = RandomInt(1, 100);
      log("atkLuckRoll: " + atkLuckRoll);

      // Append luck flavor text if player is lucky
      if (atkLuckRoll <= plrLck) {
        let msg = ` ${GetRandomArrElement(graspPhrases)} ${GetRandomArrElement(luckyPhrases)}.`;
        msg = AutoCoOpLang(plr, msg);
        attackFlavorText += msg;

        // Grant the player luck exp for using luck
        AddStat(plr, "lck", RandomFloat(0.01, 2));
      }

      // Append flavor text
      sentenceClone = sentenceClone + attackFlavorText;
    }

    // Replace sentence with modified sentence post processing
    sentences[i] = sentenceClone;

    // Update stats in sc
    StoreStatsToSC();
  }

  // Recombine sentences into text along with any mods that have been made
  text = sentences.join(" ");

  return text;
}

