// Edit text to show player health
function WarnPlayerHealth(text) {
  GetPlayerList().forEach(plr => {
    const TURNS_PER_STAT_WARN = 5;

    let plrHealth = state.players[plr].stats.hp.current;
    let plrMaxHealth = state.players[plr].stats.hp.max;
    let plrHpPercent = plrHealth / plrMaxHealth;

    // Warn player every 5 inputs, they have 50% health
    if (IsBetween(plrHpPercent, 0.45, 0.50) && state.inputCount % TURNS_PER_STAT_WARN === 0) {
      let msg = ` ${GetRandomArrElement(realizePhrases)} ${GetRandomArrElement(halfHealthPhrases)}.`;
      msg = AutoCoOpLang(plr, msg);
      text += msg;
    }

    // Warns at 1% to 10% health
    else if (IsBetween(plrHpPercent, 0.01, 0.10) && state.inputCount % TURNS_PER_STAT_WARN === 0) {
      let msg = ` ${GetRandomArrElement(realizePhrases)} ${GetRandomArrElement(lowHealthPhrases)}.`;
      msg = AutoCoOpLang(plr, msg);
      text += msg;
    }

    // Player Death at 0%
    if (plrHealth <= 0 && state.inputCount % 3 === 0) {
      let msg = ` Suddenly, ${GetRandomArrElement(dyingPhrases)} The world continues without you.`;
      msg = AutoCoOpLang(plr, msg);
      text += msg;

      // Send msg box
      state.msgHolder += AutoCoOpLang(plr, `You died! Increase your hp to revive.`);
    }

    let plrEnergy = state.players[plr].stats.ep.current;
    let plrMaxEnergy = state.players[plr].stats.ep.max;
    let plrEnergyPercent = plrEnergy / plrMaxEnergy;

    // Warns every 5 inputs, at 50% energy
    if (IsBetween(plrEnergyPercent, 0.45, 0.50) && state.inputCount % TURNS_PER_STAT_WARN === 0) {
      let msg = ` ${GetRandomArrElement(realizePhrases)} ${GetRandomArrElement(halfEnergyPhrases)} `;
      msg = AutoCoOpLang(plr, msg);
      text += msg;
    }

    // Warns at 1% to 10% energy
    else if (IsBetween(plrEnergyPercent, 0.01, 0.10) && state.inputCount % TURNS_PER_STAT_WARN === 0) {
      let msg = ` ${GetRandomArrElement(realizePhrases)} ${GetRandomArrElement(exhaustedPhrases)}`;
      msg = AutoCoOpLang(plr, msg);
      text += msg;

      state.msgHolder += AutoCoOpLang(plr, `Your energy is very low. You may want to rest or eat.\n`);
    }

    // No energy at 0%
    if (plrEnergy <= 0 && state.inputCount % TURNS_PER_STAT_WARN === 0) {
      let msg = ` Suddenly, ${GetRandomArrElement(fullExhaustionPhrases)} `;
      msg = AutoCoOpLang(plr, msg);
      text += msg;

      state.msgHolder += AutoCoOpLang(plr, `You have no energy! Recover by consuming or sleeping.\n`);
    }
  });

  return text;
}


