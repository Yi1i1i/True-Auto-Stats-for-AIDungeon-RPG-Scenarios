function ApplyModifiersToStats(plr) {
  //todo: sc race
  // get plr race
  let plrRace = state.players[plr].race;
  if (!plrRace) {
    log(`Plr race not found to apply mod to stats`);
    return false;
  }

  // get race modifiers
  mods = raceMods[plrRace];
  if (!mods) {
    log('mods dont exist for this race: ' + plrRace);
    return false;
  }

  let plrStats = state.players[plr].stats;

  // Loop through each stat and apply respective mod to current and max 
  for (let statName in plrStats) {
    let stat = plrStats[statName];

    // Get boost
    let modBoost = mods[statName + 'Mod'] / 100 + 1
    if (!modBoost) {
      continue;
    }

    // Apply
    stat.current = stat.current * modBoost;
    stat.max = stat.max * modBoost;
  }

  return true;
}

// Create new random player stats
function NewPlayerStats(plr) {
  let plrStats = state.players[plr].stats;

  // Get a random max level
  plrStats.lvl.max = RandomInt(1, 25);

  state.players[plr].skillsRewarded = Math.floor(plrStats.lvl.max / LVLS_PER_SKILL_REWARD);

  // Loop through each stat, and set max stat equal to max level
  for (let stat in plrStats) {
    plrStats[stat].max = plrStats.lvl.max;
  }

  // Give each stat a random initialized value capped by its max
  for (let stat in plrStats) {
    if (stat !== "lvl" && stat !== "exp") {
      plrStats[stat].current = RandomInt(1, plrStats[stat].max);
    }
  }

  // EXP starts at 0 and caps at 100
  plrStats.exp.current = 0;
  plrStats.exp.max = 100;

  // Stat scaling
  plrStats.hp.max = plrStats.lvl.max * 2 + 20;
  plrStats.ep.max = plrStats.lvl.max * 2 + 80;
  plrStats.mp.max = (plrStats.lvl.max * 1.5) + (plrStats.intl.current * 2) + 80;

  // Player starts at full health
  plrStats.hp.current = plrStats.hp.max;
  plrStats.ep.current = plrStats.ep.max;
  plrStats.mp.current = plrStats.mp.max;
}

