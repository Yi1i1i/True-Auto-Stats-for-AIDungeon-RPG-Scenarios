function PlayerNaturalRegen() {
  GetPlayerList().forEach(plr => {
    let plrStats = state.players[plr].stats;
    let plrMods = state.players[plr].modifiers

    // Skip if plr is dead
    if (plrStats.hp.current <= 0) return;

    // Calc regen
    let hpRegen = plrStats.hp.max * RandomFloat(0.01, 0.02) * (1 + plrMods.hp / 100);
    let mpRegen = plrStats.mp.max * RandomFloat(0.02, 0.04) * (1 + plrMods.mp / 100);

    // Apply regen
    AddStat(plr, "hp", hpRegen, 'Regen');
    AddStat(plr, "mp", mpRegen, 'Regen');

    // plr loses energy every turn
    if (plrStats.ep.current > 0) {
      let energyLoss = -1 * plrStats.ep.max * RandomFloat(0, 0.02); // up to 2% loss
      AddStat(plr, "ep", energyLoss, "Natural loss");
    }
    // Player takes damage for having no energy
    else {
      const NO_ENERGY_DAMAGE_PER_TURN = -1 * RandomFloat(plrStats.hp.max * 0.05, plrStats.hp.max * 0.15);
      AddStat(plr, "hp", NO_ENERGY_DAMAGE_PER_TURN, 'Fatigue');
    }
  });
}
