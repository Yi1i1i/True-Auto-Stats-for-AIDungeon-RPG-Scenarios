// Check if player is first entering, then is entering into rest, and replenish their stats according to their rest intensity
function ProcessResting(text) {
  if (DialogueChecker(text)) return text;

  let sentences = SplitToSentences(text);
  if (sentences.length === 0) return text;

  for (let i = 0; i < sentences.length; i++) {
    let sentence = sentences[i];
    let plr = GetPlayerInString(sentence);
    if (!plr) continue;

    let isEntering = TriggerCheck(sentence, enterWords, 3);
    let startRest = ContainsTargets(sentence, restingWords);
    if (!isEntering || !startRest) continue;

    // Determine rest intensity
    let intensity = 0;
    for (let [level, words] of Object.entries(restIntensityWords)) {
      if (ContainsTargets(sentence, words)) intensity = Number(level);
    }

    let { bonus, message } = restData[intensity];
    let restBonus = RandomFloat(...bonus);

    // Restore stats
    for (let stat of ["hp", "ep", "mp"]) {
      AddStat(plr, stat, state.players[plr].stats[stat].max * restBonus, "Rested");
    }

    sentences[i] += ` ${AutoCoOpLang(plr, message)}`;
    StoreStatsToSC();
  }

  return sentences.join(" ");
}

