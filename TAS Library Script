// Converts a talent into a skill if a cast word appears before the current talent use
function TalentToSkill(plr, words, currentIndex, talentId) {
  let plrTalents = state.players[plr].talents;
  let plrSkills = state.players[plr].skills;

  // Ensure talent exists
  let talent = plrTalents[talentId];
  if (!talent) return;

  // Search backwards for a cast word
  for (let i = currentIndex - 1; i >= 0; i--) {
    let castWord = castWords.find(word =>
      MatchesWordSequence(words, i, word.split(" "))
    );

    if (!castWord) continue;

    // Generate a unique skill ID
    let skillId = GenerateId(4);
    while (skillId in plrSkills) {
      skillId = GenerateId(4);
    }

    // Convert talent into skill
    plrSkills[skillId] = {
      name: talent.name,
      lvl: talent.lvl,
      cost: talent.cost,
      tier: talent.tier || 0
    };

    // Log conversion before deleting talent
    AddSCDescription(
      `${plr} Talents`,
      `Log ${state.turnCount} | ${talent.name} was converted to a skill.`
    );

    // Delete talent
    delete plrTalents[talentId];

    // Store data
    StoreTalentsToSC();
    StoreSkillsToSC();

    break;
  }
}

