        plrStats[statName].max = maxValue;
      }
    }
    //plrStats = Object.fromEntries(Object.entries(plrStats).sort(([a], [b]) => a.localeCompare(b)));
    //log(JSON.stringify(Object.entries(plrStats)));
  });
