// RETRIEVE data from SC and update player stats table
function RetrieveStatsFromSC() {
  GetPlayerList().forEach(plr => {
    let plrStats = state.players[plr].stats;

    // Fetch SC
    const statSC = FindStoryCard(`${plr} Stats`);
    if (!statSC) {
      log(`Stats story card not found for ${plr}.`);
      return;
    }

    let entry = statSC.entry;

    // Retrieve race
    let raceMatch = entry.match(/^RACE\s*[:\-]?\s*(.+)$/im);
    if (raceMatch) {
      state.players[plr].race = raceMatch[1].trim().toLowerCase();
    }

    // Retrieve class
    let classMatch = entry.match(/^CLASS\s*[:\-]?\s*(.+)$/im);
    if (classMatch) {
      state.players[plr].class_ = classMatch[1].trim().toLowerCase();
    }

    // Retrieve level
    let lvlMatch = entry.match(/^LVL\s*[:\-]?\s*(\d+)$/im);
    if (lvlMatch) {
      plrStats.lvl.max = Number(lvlMatch[1]);
    }

    // Retrieve all stat entries
    let statMatches = entry.matchAll(/^([a-zA-Z]+)\s*:\s*(\d+(?:\.\d+)?)\s*\/\s*(\d+(?:\.\d+)?)/gm);

    for (let match of statMatches) {
      let statName = match[1].toLowerCase();
      let currentValue = Number(match[2]);
      let maxValue = Number(match[3]);

      // Store values if the stat exists
      if (plrStats[statName]) {
