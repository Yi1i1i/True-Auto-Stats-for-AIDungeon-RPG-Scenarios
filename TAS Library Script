function ProcessStorageAction(text) {
  // Skip text that is dialogue
  if (DialogueChecker(text)) {
    return text;
  }

  // Split text into sentences
  let sentences = SplitToSentences(text);
  if (sentences.length === 0) {
    //log("No text found: " + text);
    return text;
  }

  // Loop through each sentence
  for (let ind = 0; ind < sentences.length; ind++) {
    let sentence = sentences[ind];

    // Get current player in sentence
    let plr = GetPlayerInString(sentence);
    if (!plr) {
      log("No player found in sentence: " + sentence);
      continue;
    }
    //log("Player found: " + plr);

    // Get and combine all talent key triggers created by plr
    let allTalentKeys = [];
    for (let talentData of Object.values(state.players[plr].talents)) {
      for (let key of talentData.keys) {
        allTalentKeys.push(key.trim().toLowerCase());
      }
    }

    // Combine trigger words into one table
    let actionWords = [...castWords, ...talentWords, ...healingWords, ...allTalentKeys];

    // Check for pronoun and trigger words to see if action is requested
    let startAction = TriggerCheck(sentence, actionWords, 3);
    if (!startAction) {
      continue;
    }

    // Action is requested, initialize
    let actionFlavorText = "";
    let storages = {
      items: state.players[plr].inv,
      talents: state.players[plr].talents,
      skills: state.players[plr].skills
    };

    // Break current sentence into words
    let words = RemovePunctuation(sentence).split(/\s+/);

    // Loop through each word, find element matches, and execute them.
    for (let i = 0; i < words.length; i++) {
      // Skip if current word is a filler
      if (ContainsTargets(words[i], fillerWords) ||
        ContainsTargets(words[i], GetPlayerList())) {
        continue;
      }

      // Initialize holders for matched elements
      let partialMatches = [];
      let fullMatches = [];

      // Loop through storages and save matched elements and match type
      for (let storageType in storages) {
        let storage = storages[storageType];

        for (let id in storage) {
          let elementName = storage[id].name;
          let elementWords = elementName.toLowerCase().split(/\s+/);

          // Check for full match against consecutive words
          let fullMatch = MatchesWordSequence(words, i, elementWords);

          // Check for partial match against current word unless word is too common to partial match
          let currentWord = words[i].toLowerCase();
          let partialMatch = currentWord.length >= 4 && !ContainsTargets(currentWord, actionWords) && elementName.toLowerCase().startsWith(currentWord);

          // Save matches
          let match = { id, name: elementName, storageType };

          if (fullMatch) {
            match.matchType = 'full';
            fullMatches.push(match);
          } else if (partialMatch) {
            match.matchType = 'partial';
            partialMatches.push(match);
          }
        }
      }

      // Loop through plr talents and save talents whose keys match
      for (let [talentId, talentData] of Object.entries(state.players[plr].talents)) {
        let keyMatch = talentData.keys.some(key =>
          MatchesWordSequence(words, i, key.trim().split(" "))
        );

        let alreadyMatched = fullMatches.some(match =>
          match.id === talentId && match.storageType === "talents"
        );

        if (keyMatch && !alreadyMatched) {
          fullMatches.push({
            id: talentId,
            name: talentData.name,
            storageType: "talents",
            matchType: "full"
          });
        }
      }

      // Find the first usable full match else partial match that passes checks
      let chosenElement = fullMatches.find(match => ElementCheck(plr, match.storageType, match.id));
      if (!chosenElement) {
        chosenElement = partialMatches.find(match => ElementCheck(plr, match.storageType, match.id));
      }

      // CASE: Chosen element found and passed checks. Process and execute element.
      if (chosenElement) {
        actionFlavorText += ProcessElement(sentence, plr, chosenElement.storageType, chosenElement.id, chosenElement.matchType);

        // Check if chosen element is a casted talent that should turn into skill
        TalentToSkill(plr, words, i, chosenElement.id);

        // Advance word loop index by chosen element length to prevent overmatching
        if (chosenElement.matchType == "full") {
          let advance = chosenElement.name.split(" ").length - 1;
          i += advance;
        }
        continue;
      }
      // CASE: No chosen element because all matched elements failed checks
      else if (fullMatches.length > 0 || partialMatches.length > 0) {
        let failedElement = null;

        // Attribute failure to the first full match; otherwise, use the first partial match
        if (fullMatches.length > 0) {
          failedElement = fullMatches[0];
        } else {
          failedElement = partialMatches[0];
        }

        // Create flavor text
        let costNames = {
          skills: "mana",
          talents: "energy",
          items: "quantity"
        };
        let costName = costNames[failedElement.storageType];

        let msg = GetRandomArrElement(notEnoughPhrases).replace("[Stat]", costName).replace("[Thing]", failedElement.name);
        msg = AutoCoOpLang(plr, msg);
        actionFlavorText += msg;

        if (failedElement.matchType == "full") {
          let advance = failedElement.name.split(" ").length - 1;
          i += advance;
        }

        continue;
      }
    }

    // CASE: If no matches after iterating through this sentence, plr requested action but lacks the element to execute it. Feed fail msg to context
    if (actionFlavorText == "") {
      let msg = ` You realize no applicable items except ${GetAllPlayerItemNames(plr)}. You realize no applicable talents except ${GetAllPlayerTalentNames(plr)}. You realize no applicable skills except ${GetAllPlayerSkillNames(plr)}. You anticipate failure for not currently having the right thing.`;
      msg = AutoCoOpLang(plr, msg);
      state.contextAppendment += msg;
      log('Requested action failed.', msg);
      continue;
    }

    // Append all flavor texts for this sentence.
    sentences[ind] = sentence + actionFlavorText;
  }

  text = sentences.join(" ");
  return text;
}

