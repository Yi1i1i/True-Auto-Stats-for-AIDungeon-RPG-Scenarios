// Apply modifiers to stat gains
function ApplyModifier(plr, statName, incAmt) {
  let modifier = state.players[plr].modifiers[statName] || 0;
  let temp = incAmt * modifier / 100;

  // Ensure modifiers don't reverse their effect on negative gains
  if (incAmt < 0) {
    temp *= -1;
  }

  return incAmt + temp;
}

// Scales input amount based on the current player stat
function ApplyStatScaling(amt, currentStat) {
  let result = amt * (1.32 * Math.exp(-0.02 * currentStat));

  // Ensure result is never scaled to 0
  result += 0.01;

  return result;
}

// Log stat changes in the Stats story card description
function LogStatChange(plr, statName, oldValue, newValue, rawAmt, moddedAmt, scaledAmt, reason) {
  //round
  oldValue = RoundFloat(oldValue, 2);
  newValue = RoundFloat(newValue, 2);
  rawAmt = RoundFloat(rawAmt, 2);
  moddedAmt = RoundFloat(moddedAmt, 2);
  scaledAmt = RoundFloat(scaledAmt, 2);

  // Log stat change
  let sign = moddedAmt >= 0 ? "🟢" : "🔴";
  let logEntry = `Log ${state.turnCount} | ${plr} ${statName.toUpperCase()} ${sign}: ${oldValue} → ${newValue}`;

  // add inc amt to log
  if (scaledAmt !== null) {
    logEntry += ` [Scaled: ${scaledAmt}, Modded: ${moddedAmt}, Raw: ${rawAmt}]`;
  } else {
    logEntry += ` [Modded: ${moddedAmt}, Raw: ${rawAmt}]`;
  }

  // add reason
  if (reason && reason.length > 0) {
    logEntry += ` (${reason})`;
  }

  // modify sc des
  AddSCDescription(
    `${plr} Stats`,
    logEntry
  );

}

// Add stat changes to the message holder
function MsgStatChange(plr, statName, incAmt) {
  incAmt = RoundFloat(incAmt, 2);

  let sign = incAmt >= 0 ? "🟢" : "🔴";

  state.msgHolder += `⬛ ${plr}: ${incAmt} ${statName.toUpperCase()} ${sign} ⬛ \n`;
}

// Handle player level-ups and increase maximum stats
function OnLevelUp(plr) {
  let plrStats = state.players[plr].stats;
  let maxLevel = plrStats.lvl.max;

  // Calculate level increases from EXP
  let lvlIncrement = Math.floor(plrStats.exp.current / plrStats.exp.max);
  if (lvlIncrement <= 0) return;

  // Calculate leftover EXP
  plrStats.exp.current = plrStats.exp.current - (lvlIncrement * plrStats.exp.max);

  // Increment level
  plrStats.lvl.max += lvlIncrement;

  // Loop through each max stat and increase max stat
  for (let statName in plrStats) {
    if (statName === "lvl" || statName === "exp") continue;

    let stat = plrStats[statName];
    let modifier = state.players[plr].modifiers[statName + "Mod"] || 0;

    // Calculate max stat increase
    let increase = MAXSTAT_INC_PER_LVL_UP;
    let modAmt = MAXSTAT_INC_PER_LVL_UP * (modifier / 100);

    if (statName === "mp") {
      increase = (plrStats.intl.current * 0.1) + MAXSTAT_INC_PER_LVL_UP + modAmt;
    }
    else {
      increase = MAXSTAT_INC_PER_LVL_UP + modAmt;
    }

    // Apply max stat increase
    stat.max += increase * lvlIncrement;

    // Keep current stats within their new maximum
    if (stat.current > stat.max) {
      stat.current = stat.max;
    }
  }

  // log lvl change to stat sc
  AddSCDescription(
    `${plr} Stats`,
    `Log ${state.turnCount} | LVL ${maxLevel} → ${plrStats.lvl.max}`
  );

  // update msg box
  state.msgHolder += `${plr} has leveled up to ${plrStats.lvl.max}\n`;

}

// Main function to change player stats 
function AddStat(plr, statName, incAmt, reason = "") {
  // Verify inc amt
  if (typeof incAmt !== "number") {
    log('ChangeStat error, not a number ' + incAmt);
    return false;
  }

  // Verify stat exists
  let plrStats = state.players[plr].stats;
  if (!plrStats[statName]) {
    log('ChangeStat error, invalid stat ' + statName);
    return false;
  }

  // Apply modifiers to inc amt
  moddedAmt = ApplyModifier(plr, statName, incAmt);
  log(`incAmt: ${statName} ${incAmt} ${moddedAmt}`);

  // Initialize
  let statData = plrStats[statName];
  let scaledAmt = null;
  let overflow = 0;

  // Save current stat for logging
  let oldStat = statData.current;

  // CASE: HP, MP, and EP use direct changes without stat scaling
  if (statName === "hp" || statName === "mp" || statName === "ep") {
    // Apply stat change
    statData.current = statData.current + moddedAmt;

    // Prevent exceeding maximum
    if (statData.current > statData.max) {
      statData.current = statData.max;
    }
  }
  // CASE: Other stats use scaled changes
  else {
    // Scale amt based on current player stat
    scaledAmt = ApplyStatScaling(moddedAmt, statData.current);
    log(`Scaled incAmt: ${scaledAmt}`);

    // Get new player stat
    let newStat = statData.current + scaledAmt;
    log(`newStat: ${newStat}`);

    // Get overflow if new stat passes max stat
    overflow = newStat - statData.max;
    log(`overflow: ${overflow}`);

    // Update stat to new stat value capped at maximum
    statData.current = Math.min(newStat, statData.max);
  }

  // If stat has overflowed max stat, pass to exp. Check for level ups.
  if (overflow > 0) {
    let maxLevel = plrStats.lvl.max;
    let plrExp = plrStats.exp;

    // Calculate scaled exp gain
    let expGain = 100 * ApplyStatScaling(overflow, maxLevel);
    log(`EXP gained: ${expGain}`);

    // Update current exp
    plrExp.current += expGain;

    // Level up if EXP reaches its maximum
    if (plrExp.current >= plrExp.max) {
      OnLevelUp(plr);
    }

    AddSCDescription(
      `${plr} Stats`,
      `Log ${state.turnCount} | Player gained ${expGain.toFixed(2)} EXP`
    );
  }

  // Only log changes
  if (oldStat !== statData.current) {
    LogStatChange(plr, statName, oldStat, statData.current, incAmt, moddedAmt, scaledAmt, reason);

    MsgStatChange(plr, statName, incAmt);
  }

  // Update stats sc
  StoreStatsToSC();

  return true;
}

function AddMaxStat(plr, statName, incAmt) {
