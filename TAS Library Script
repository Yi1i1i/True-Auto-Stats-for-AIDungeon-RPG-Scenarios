// Function to create new class skills for player and store to their skills
function CreateClassSkills(plr, numOfSkills, wipeOldSkills) {
  let className = state.players[plr].class_;
  let createdHolder = [];

  if (!className || !classSkillParts[className]) {
    log("class error when creating skill: " + className);
    return createdHolder;
  }

  // Wipe old skills if flag is set
  if (wipeOldSkills) {
    state.players[plr].skills = {};
  }

  // Make starting skills
  for (let i = 0; i < numOfSkills; i++) {
    // Pick two different random skill parts to combine
    let part1, part2;
    let skillParts = classSkillParts[className];

    do {
      let part1Index = RandomInt(0, skillParts.length - 1);
      let part2Index = RandomInt(0, skillParts.length - 1);

      part1 = skillParts[part1Index];
      part2 = skillParts[part2Index];
    } while (part1 === part2);

    let createdSkill = `${part1} ${part2}`;
    let skillId = GenerateId(4);

    // Ensure ID is unique
    while (skillId in state.players[plr].skills) {
      skillId = GenerateId(4);
    }

    createdHolder.push(createdSkill);

    state.players[plr].skills[skillId] = {
      name: createdSkill,
      lvl: RandomInt(0, 9),
      cost: RandomInt(10, 40),
      tier: 0
    };
  }

  // Return string of created skills
  if (createdHolder.length > 0) {
    createdHolder = createdHolder.join(", ");
  }

  // Log in skill sc
  AddSCDescription(
    `${plr} Skills`,
    `Log ${state.turnCount} | Skills Acquired 📖: ${createdHolder}`
  );

  return createdHolder;
}

