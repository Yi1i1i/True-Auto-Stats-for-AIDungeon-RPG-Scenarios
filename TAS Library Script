      return;
    }

    talentSC.description = "Format: TalentName (LVL) (EP) (Keys) <id>";
  });
}

// STORE talents to SC
function StoreTalentsToSC() {
  GetPlayerList().forEach(plr => {
    // Fetch talent SC
    let talentSC = FindStoryCard(`${plr} Talents`);
    if (!talentSC) {
      log(`Talent story card not found for ${plr}.`);
      return;
    }

    // Format and store talents
    let entryLines = [];
    let talents = state.players[plr].talents;

    for (let [talentId, talentData] of Object.entries(talents)) {
      let name = talentData.name;
      let lvl = RoundFloat(talentData.lvl, 2);
      let cost = RoundFloat(talentData.cost, 2);
      let keys = talentData.keys;

      entryLines.push(`${name} (Lvl ${lvl}) (${cost} EP) (Keys: ${keys}) <${talentId}>`);
    }

    talentSC.entry = entryLines.join("\n");

    // Trim notes on char limit to prevent memory overload
    TrimSCDescription(talentSC, 3000);
  });

  return true;
}

// RETRIEVE talents from SC
function RetrieveTalentsFromSC() {
  GetPlayerList().forEach(plr => {
    // Fetch talent SC
    let talentSC = FindStoryCard(`${plr} Talents`);
    if (!talentSC) {
      log(`Talent story card not found for ${plr}.`);
      return;
    }

    // Keep existing player talents
    let plrTalents = state.players[plr].talents;
    let retrievedTalents = [];
    let newTalents = [];

    // Extract talent name, lvl, cost, keys, and optional ID
    let regex = /^(.+?)\s*\([^)]*?(-?\d+(?:\.\d+)?)[^)]*\)\s*\([^)]*?(-?\d+(?:\.\d+)?)[^)]*\)(?:\s*\((?:Keys:\s*)?([^)]+?)\s*\))?(?:\s*<([^>]+)>)?$/gim;
    let matches = talentSC.entry.matchAll(regex);

    for (let match of matches) {
      let name = match[1].trim();
      let lvl = Number(match[2]) || 0;
      let cost = Number(match[3]) || 0;
      let keys = match[4]
        ? match[4].trim().split(",").map(key => key.trim()).filter(Boolean)
        : [];
      let talentId = match[5] ? match[5].trim() : GenerateId(4);

      // Save retrieved talent ID
      retrievedTalents.push(talentId);

      // Preserve existing talent data and update retrieved fields
      if (plrTalents[talentId]) {
        plrTalents[talentId].name = name;
        plrTalents[talentId].lvl = lvl;
        plrTalents[talentId].cost = cost;
        plrTalents[talentId].keys = keys;
      }
      // Newly retrieved talent
      else {
        while (talentId in plrTalents) {
          talentId = GenerateId(4);
        }

        newTalents.push(talentId);
        plrTalents[talentId] = { name, lvl, cost, keys };
      }
    }

    // Remove talents that no longer exist in the story card
    Object.keys(plrTalents).forEach(talentId => {
      if (
        !retrievedTalents.includes(talentId) &&
        !newTalents.includes(talentId)
      ) {
        delete plrTalents[talentId];
      }
    });
  });
}

// Detects pronoun and learn triggers then processes talent learning by selecting input words that pass a weight threshold. When new talent is available, rolls to see if player will learn it.
function ProcessTalentLearning(text) {
  // Skip text that is dialogue
  if (DialogueChecker(text)) return text;

  // Split text into sentences
  let sentences = SplitToSentences(text);
  if (sentences.length === 0) {
    //log("No text found: " + text);
    return text;
  }

  for (let i = 0; i < sentences.length; i++) {
    let sentence = sentences[i];

    // Get current player in sentence
    let plr = GetPlayerInString(sentence);
    if (!plr) continue;

    // Check if learning is requested
    let isLearning = TriggerCheck(sentence, learnWords, 3);
    if (!isLearning) continue;

    // Get words to filter from sentence
    let filterArr = [
      ...fillerWords,
      ...learnWords,
      ...titleWords,
      ...youWords,
      ...selfWords,
      ...GetPlayerList()
    ];

    // Filter sentence and split into words
    let cleanSentence = RemovePunctuation(sentence);
    let filteredWords = FilterSentence(cleanSentence, filterArr)
      .split(/\s+/)
      .filter(Boolean);

    if (filteredWords.length === 0) {
      log("Talent learn error: filtered out all sentence words.");
      continue;
    }

    // Remove duplicate words
    filteredWords = [...new Set(filteredWords)];

    let weights = {
      threshold: 2.5,
      newPart: 0,
      capitalized: 1.5,
      alrLearning: 1,
      decay: 0.5,
      outpaced: 2
    };

    let potentialTalents = state.players[plr].potentialTalents;

    // Decay words that weren't mentioned
    for (let j = potentialTalents.length - 1; j >= 0; j--) {
      let partData = potentialTalents[j];

      if (filteredWords.includes(partData.part)) continue;

      partData.weight = Math.max(0, partData.weight - weights.decay);

      if (partData.weight === 0) {
        potentialTalents.splice(j, 1);
      }
    }

    // Save words and update their weights
    for (let word of filteredWords) {
      let partData = potentialTalents.find(entry => entry.part === word);

      // Case: word is new
      if (!partData) {
        partData = {
          part: word,
          weight: weights.newPart
        };

        potentialTalents.push(partData);
      }

      // Case: word starts with capital
      if (IsCapitalized(word)) {
        partData.weight += weights.capitalized;
      } else {
        partData.weight += weights.alrLearning;
      }
    }

    // Log potential talents to SC
    AddSCDescription(
      `${plr} Talents`,
      `Log ${state.turnCount} | Potential Talents: ${JSON.stringify(potentialTalents)}`
    );

    // Collect words that reached the threshold
    let talentParts = potentialTalents
      .filter(partData => partData.weight >= weights.threshold)
      .map(partData => partData.part);

    // No parts have reached threshold, append fail flavor text
    if (talentParts.length === 0) {
      sentences[i] = AutoCoOpLang(
        plr,
        `${sentence} ${GetRandomArrElement(talentLearnFailPhrases)}`
      );
      continue;
    }

    // Get player INTL and LCK
    let plrStats = state.players[plr].stats;
    let plrIntl = plrStats.intl.current;
    let plrLck = plrStats.lck.current;

    let baseChance = 30;

    // 100 INTL = 40 bonus; each point above 100 adds 0.025, capped at 50
    function GetIntlFactor(num) {
      if (num <= 100) {
        return num * 0.4;
      }

      return Math.min(50, 40 + (num - 100) * 0.025);
    }

    // 100 LCK = 20 bonus, capped at 20
    let intlFactor = GetIntlFactor(plrIntl);
    let lckFactor = Math.min(20, plrLck * 0.2);

    // Roll to see if player learns the talent
    let learnChance = baseChance + intlFactor + lckFactor;
    let roll = RandomInt(0, 100);

    AddSCDescription(
      `${plr} Talents`,
      `Log ${state.turnCount} | Learn chance: ${learnChance.toFixed(2)}, roll: ${roll}`
    );

    // Player failed roll, return fail flavor text
    if (roll >= learnChance) {
      sentences[i] = AutoCoOpLang(
        plr,
        `${sentence} ${GetRandomArrElement(talentLearnFailPhrases)}`
      );
      continue;
    }

    // Create talent name in discovery order
    let newTalent = talentParts.map(part => CapitalizeFirst(part)).join(" ");

    // Ensure player doesn't already own a talent with the same name
    let plrTalents = state.players[plr].talents;
    let talentExists = Object.values(plrTalents).some(
      talent => talent.name.toLowerCase() === newTalent.toLowerCase()
    );

    // Player already has talent, skip
    if (talentExists) {
      log("Player already has talent: " + newTalent);
      continue;
    }

    // Generate a unique talent ID
    let id = GenerateId(4);
    while (id in plrTalents) {
      id = GenerateId(4);
    }

    // Save new talent
    plrTalents[id] = {
      name: newTalent,
      lvl: RandomInt(0, 3),
      cost: RandomInt(5, 30),
      keys: [],
      tier: 0
    };

    AddSCDescription(
      `${plr} Talents`,
      `Log ${state.turnCount} | Learned ${plrTalents[id].name}`
    );

    // Store the exact talent ID for energy cost processing
    state.askEnergyCost[plr] = id;
    log("state.askEnergyCost[plr]: " + state.askEnergyCost[plr]);

    // Remove learned words from potential talents
    state.players[plr].potentialTalents = potentialTalents.filter(
      partData => !talentParts.includes(partData.part)
    );

    potentialTalents = state.players[plr].potentialTalents;

    // Since talent was learned, decrease potential talent weights for being outpaced
    for (let j = potentialTalents.length - 1; j >= 0; j--) {
      let partData = potentialTalents[j];

      partData.weight = Math.max(0, partData.weight - weights.outpaced);

      if (partData.weight === 0) {
        potentialTalents.splice(j, 1);
      }
    }

    // Talent learning success message
    let learningFlavorText = AutoCoOpLang(
      plr,
      ` You successfully learn ${newTalent}. You check its energy cost amount.`
    );

    // Learning grants INTL
    AddStat(plr, "intl", RandomFloat(0.01, 3), "Studying Talents");

    sentences[i] = sentence + learningFlavorText;

    StoreTalentsToSC();
    StoreStatsToSC();
  }

  return sentences.join(" ");
}
// After a talent is learned, extract energy cost from ai output or create random.
function GetLearnedTalentCost(text) {
  GetPlayerList().forEach(plr => {
    let talentId = state.askEnergyCost[plr];
    if (!talentId) return;

    let talent = state.players[plr].talents[talentId];

    if (!talent) {
      state.askEnergyCost[plr] = false;
      return;
    }

    // Extract numbers from AI output
    let numbers = (text.match(/\d+(?:\.\d+)?/g) || []).map(Number);

    // Filter out 100 from x/100 outputs
    if (numbers.length > 1) {
      numbers = numbers.filter(value => value !== 100);
    }

    let energyCost = numbers.length > 0 ? Math.max(...numbers) : 0;

    // Use AI cost if available; otherwise generate a random cost
    if (energyCost > 0 && GetPlayerCount() <= 1) {
      talent.cost = energyCost;
    } else {
