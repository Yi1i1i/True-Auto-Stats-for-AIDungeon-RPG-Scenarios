function ProcessExercise(text) {
  // Skip text that is dialogue
  if (DialogueChecker(text)) {
    return text;
  }

  // Split text into sentences
  let sentences = SplitToSentences(text);
  if (sentences.length === 0) {
    //log("No text found: " + text);
    return text;
  }

  // Loop through each sentence
  for (let i = 0; i < sentences.length; i++) {
    let sentence = sentences[i];

    // Get current player in sentence
    let plr = GetPlayerInString(sentence);
    if (!plr) {
      continue;
    }

    // Check if exercising is requested
    let startExercise = TriggerCheck(sentence, Object.values(exerciseWords).flat(), 3);
    let isDoing = ContainsTargets(sentence, doWords);
    log("startExercise: " + startExercise);
    log("isDoing: " + isDoing);

    // Exercise only if both conditions are met
    if (!startExercise || !isDoing) {
      continue;
    }

    // Process input
    let sentenceClone = RemovePunctuation(EnglishToNumbers(sentence));
    let inputTokens = sentenceClone.split(/\s+/);

    // Get player stats
    let plrStats = state.players[plr].stats;
    let plrHp = plrStats.hp.current;
    let plrEp = plrStats.ep.current;

    // Initialize requested exercises
    let requestedExercises = [];

    // Loop through each input word and find exercises
    for (let j = 0; j < inputTokens.length; j++) {
      let matchedExercise = null;
      let matchedTier = null;
      let matchedLength = 0;

      // Check each exercise tier
      for (let tier = 1; tier <= Object.keys(exerciseWords).length; tier++) {
        for (let exercise of exerciseWords[tier]) {
          let exerciseParts = exercise.toLowerCase().split(" ");

          // Check for full match
          if (!MatchesWordSequence(inputTokens, j, exerciseParts, true)) {
            continue;
          }

          matchedExercise = exercise;
          matchedTier = tier;
          matchedLength = exerciseParts.length;
          break;
        }

        if (matchedExercise !== null) {
          break;
        }
      }

      if (matchedExercise === null) {
        continue;
      }

      // Get reps stated before exercise
      let reps = GetPriorNumber(inputTokens, j, true) || 1;

      requestedExercises.push({
        name: matchedExercise,
        tier: matchedTier,
        reps: reps
      });

      // Skip remaining words in the matched exercise name
      j += matchedLength - 1;
    }
    log("requestedExercises: " + JSON.stringify(requestedExercises));

    // Initialize total stat changes
    let totalEpCost = 0;
    let totalHpCost = 0;
    let totalAtkGain = 0;
    let totalDefGain = 0;
    let totalSpdGain = 0;
    let totalMaxEpGain = 0;

    let completedExercises = [];

    // Execute exercises and accumulate stat changes
    for (let exercise of requestedExercises) {
      let exerciseData = exerciseTierData[exercise.tier];
      let completedReps = 0;

      for (let rep = 0; rep < exercise.reps; rep++) {
        // Check whether player can afford another rep
        let remainingEp = plrEp - totalEpCost;
        let remainingHp = plrHp - totalHpCost;

        if (exerciseData.epCost >= remainingEp ||
          exerciseData.epCost >= remainingHp) {
          break;
        }

        // Accumulate costs
        totalEpCost += exerciseData.epCost;
        totalHpCost += exerciseData.hpCost;

        // Accumulate stat gains
        totalAtkGain += exerciseData.atkGain;
        totalDefGain += exerciseData.defGain;
        totalSpdGain += exerciseData.spdGain;
        totalMaxEpGain += exerciseData.maxEpGain;

        completedReps++;
      }

      if (completedReps > 0) {
        completedExercises.push(`${completedReps} ${exercise.name}`);
      }
    }
    log("completedExercises: " + JSON.stringify(completedExercises));

    // Generate exercise flavor text
    let exerciseFlavorText = "";

    // CASE: plr completed at least some exercises
    if (completedExercises.length > 0) {
      // Apply accumulated stat changes once
      AddStat(plr, "ep", -totalEpCost, 'Exercise energy used');
      AddStat(plr, "hp", -totalHpCost, 'Exercise damage');
      AddStat(plr, "atk", totalAtkGain, 'Exercise boost');
      AddStat(plr, "def", totalDefGain, 'Exercise boost');
      AddStat(plr, "spd", totalSpdGain, 'Exercise boost');
      AddMaxStat(plr, "ep", totalMaxEpGain);

      // append flavor text
      let msg = ` You complete ${completedExercises.join(", ")}.`;
      msg = AutoCoOpLang(plr, msg);
      exerciseFlavorText += msg;
    }
    // CASE: Plr can not complete any exercises
    if (requestedExercises.length > 0 && completedExercises.length <= 0) {
      let msg = ` You don't have enough strength to complete them.`;
      msg = AutoCoOpLang(plr, msg);
      exerciseFlavorText += msg;
    }

    // Update stats in SC
    StoreStatsToSC();

    // Append flavor text and update sentence
    sentences[i] = sentence + exerciseFlavorText;
  }

  // Recombine sentences
  text = sentences.join(" ");
  return text;
}

