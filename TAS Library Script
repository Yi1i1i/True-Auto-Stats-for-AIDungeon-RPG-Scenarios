// Injects all player data into the ai context as world lore
function PlayerDataToContext(text) {
  if (!state.settings.statsToContext) {
    return text;
  }

  GetPlayerList().forEach(plr => {
    // Get all player skills and translate them to AI-readable text
    let skillHolder = [];
    for (let [skillId, skillData] of Object.entries(state.players[plr].skills)) {
      let tier = GetEnglishTier(skillData.lvl);
      let skillName = skillData.name;
      skillHolder.push(`${tier} ${skillName}`);
    }
    let skillsText = skillHolder.join(", ");
    if (skillsText.length <= 0) { skillsText = "nothing" }

    // Store all player talents and translate them to AI-readable text
    let talentHolder = [];
    for (let [talentId, talentData] of Object.entries(state.players[plr].talents)) {
      let tier = GetEnglishTier(talentData.lvl);
      let talentName = talentData.name;
      talentHolder.push(`${tier} ${talentName}`);
    }
    let talentsText = talentHolder.join(", ");
    if (talentsText.length <= 0) { talentsText = "nothing" }


    // Store all player inventory amounts and items
    let itemHolder = [];
    for (let [itemId, itemData] of Object.entries(state.players[plr].inv)) {
      itemHolder.push(`${itemData.amt} ${itemData.name}`);
    }
    let itemsText = itemHolder.join(", ");
    if (itemsText.length <= 0) { itemsText = "nothing" }

    // Store all player stats in a holder, excluding EXP
    let statsHolder = [];
    for (let [statKey, statData] of Object.entries(state.players[plr].stats)) {
      if (statKey === "exp") {
        continue;
      }

      let statName = statData.name.toLowerCase();
      let current = RoundFloat(statData.current, 2);
      let max = RoundFloat(statData.max, 2);

      if (statKey == "lvl") {
        let currentTier = GetEnglishTier(max);
        statsHolder.push(
          `Level ${max} (${currentTier})`
        );
      }
      // HP, MP, and EP show capacity and scaled tiers
      else if (["hp", "mp", "ep"].includes(statKey)) {
        let currentCapacity = GetEnglishCapacity(current, max);
        let currentTier = GetEnglishTier(current / 10);

        statsHolder.push(
          `${currentCapacity} (${current}/${max}) ${currentTier} ${statName}`
        );
      }
      // All other stats show their current tier
      else {
        let currentTier = GetEnglishTier(current);

        statsHolder.push(
          `${currentTier} (${current}/${max}) ${statName}`
        );
      }
    }
    let statsText = statsHolder.join(", ");

    // Get plr race and class
    let plrRace = state.players[plr].race;
    let plrClass = state.players[plr].class_;

    // Create msg and append as world lore
    let msg = `[Player race is ${plrRace}. Player class is ${plrClass}. Player stats are ${statsText}. Assume player inventory has only ${itemsText}. Player talents are only ${talentsText}. Player skills are only ${skillsText}.]\n`
    msg = AutoCoOpLang(plr, msg);
    text = InsertAfterWorldLore(text, msg);
    //log('PlayerDataToContext: ' + msg);
  });

  return text;
}

