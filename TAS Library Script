// Allows user to add a player by typing /add "name"
function AddPlrCmdInput(text) {
  if (text.includes("/add") && !text.includes("say")) {
    let playerAddList = [...text.matchAll(/"([^"]+)"/g)].map(match => match[1]);

    let plrsAdded = [];
    playerAddList.forEach(name => {
      let success = AddPlayer(name);

      if (success) {
        plrsAdded.push(name);
      }
    });

    if (plrsAdded.length > 0) {
      text = `<< ➕ Successfully added ${plrsAdded.join(", ")} >>`;
    }
    else {
      text = `<< ⚠️ No new players were added. >>`;
    }
  }

  return text;
}

// Allows user to remove a player by typing /remove "name"
function RemovePlrCmdInput(text) {
  if (!text.includes("/remove") || text.includes("say")) return text;

  let playerNames = [...text.matchAll(/"([^"]+)"/g)].map(match => match[1]);
  let removedPlayers = [];

  for (let name of playerNames) {
    if (!RemovePlayer(name)) continue;
    removedPlayers.push(name);

    for (let type of ["Stats", "Modifiers", "Inventory", "Talents", "Skills"]) {
      DeleteStoryCard(`${name} ${type}`);
    }
  }

  if (removedPlayers.length > 0) {
    return `<< 🗑️ Successfully removed ${removedPlayers.join(", ")} >>`;
  }

  return `<< ⚠️ No players were removed. >>`;
}

function ListPlrCmdInput(text) {
  if (text.includes("/playerlist")) {
    text = `<< ${GetPlayerList()} >>`;
  }

  return text;
}

