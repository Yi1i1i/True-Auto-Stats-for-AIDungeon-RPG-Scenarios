function CreateHurtRegexs(target) {
  let bodyPartList = bodyParts.join("|");

  return {
    1: [
      // Scraping, bumping, bruising, etc.
      new RegExp(`\\b(?:bump|bumps|bumping|bruise|bruised|bruising|graze|grazed|grazes|grazing|nick|nicked|nicking|nicks|pressing|presses|scorching|scorched|scorches|scrape|scraped|scrapes|scraping|singeing|singes|sting|stinging|stings)(?:\\s+\\w+){0,4}\\s+${target}(?:\\s+\\w+){0,5}\\s+(?:${bodyPartList})\\b`, "i"),

      // Feeling minor pain
      new RegExp(`\\b${target}(?:\\s+\\w+){0,3}\\s+(?:feel|feeling|felt|feels|winces|wincing|winced)(?:\\s+\\w+){0,5}\\s+(?:ache|aching|bruise|bruising|bruised|sting|stinging|throb|throbbing)\\b`, "i"),

      // Target's body aches
      new RegExp(`\\b${target}'s\\s+(?:${bodyPartList})\\s+(?:throb|throbs|throbbing|ache|aches|aching|contorts|contorting|snaps shut)\\b`, "i"),

      // Stumbling and falling
      new RegExp(`\\b${target}(?:\\s+\\w+){0,3}\\s+(?:contorts|contorting|fall|falling|falls|fell|stumble|stumbled|stumbles|stumbling|strains|straining|slam|slammed|slamming|slams|staggers|staggering|trip|tripping|trips|tumbled|yanked)(?:\\s+\\w+){0,3}\\s+(?:against|around|back|backward|down|forward|into|on|off|over|sideways|towards)?\\b`, "i"),

      // Pain throbbing
      new RegExp(`\\bThe(?:\\s+\\w+){0,3}\\s+pain(?:\\s+\\w+){0,4}\\s+(?:throbbing)\\b`, "i")
    ],

    2: [
      // Biting, burning, hitting, striking, etc.
      new RegExp(`\\b(?:bite|biting|bites|burn|burning|burns|catches|catching|dig|digs|digging|hit|hitting|hits|jab|jabbing|jabs|knock|knocked|knocking|sear|sears|searing|shock|shocking|shocks|strike|strikes|striking|struck|whack|whacked|whacking|whacks|sharp)(?:\\s+\\w+){0,3}\\s+${target}(?:\\s+\\w+){0,5}\\s+(?:${bodyPartList})\\b`, "i"),

      // Choking and struggling for air
      new RegExp(`\\b${target}(?:\\s+\\w+){0,3}\\s+(?:chokes|sputters|coughs|fights for air|wheezes|wheezing)\\b`, "i"),

      // Knocking or slamming target
      new RegExp(`\\b(?:knocks|knocking|slamming|slams)(?:\\s+\\w+){0,3}\\s+${target}\\b`, "i"),

      // Sending target crashing
      new RegExp(`\\b(?:send|sending|sends|throws|throwing)(?:\\s+\\w+){0,3}\\s+${target}(?:\\s+\\w+){0,5}\\s+(?:crumpling|crashing|flailing|reeling|skidding|slamming|smashing|sprawling|toppling|tumbling)\\b`, "i"),

      // Pain burning or searing
      new RegExp(`\\bThe(?:\\s+\\w+){0,3}\\s+pain(?:\\s+\\w+){0,4}\\s+(?:burning|searing)\\b`, "i"),

      // Pain pulsing through target's body
      new RegExp(`\\b(?:pain|sting)\\b(?:\\s+\\w+){0,3}\\s+(?:flares|pulses|burns|shoots)(?:\\s+\\w+){0,5}\\s+(?:through|along|across|down|into|up)\\s+(?:\\w+\\s+)?${target}'s\\s+(?:${bodyPartList})\\b`, "i"),

      // Shock traveling through target's body
      new RegExp(`\\b(?:shock|shocks|shocking|shocked)(?:\\s+\\w+){0,2}\\s+(?:up|down|through|along)\\s+${target}'s\\s+(?:${bodyPartList})\\b`, "i")
    ],

    3: [
      // Piercing, slicing, slashing, etc.
      new RegExp(`\\b(?:agony|agonizing|batter|battered|battering|collide|collides|fling|flinging|flung|pierce|pierced|pierces|piercing|slam|slams|slammed|slamming|slice|slices|sliced|slicing|shoot|shooting|shoots|slash|slashes|slashed|slashing|gashes)(?:\\s+\\w+){0,3}\\s+${target}(?:\\s+\\w+){0,5}\\s+(?:${bodyPartList})\\b`, "i"),

      // Pain exploding through target's body
      new RegExp(`\\b(?:pain|sting)\\b(?:\\s+\\w+){0,3}\\s+(?:blossoms|explode|explodes|bursts)(?:\\s+\\w+){0,5}\\s+(?:through|along|across|down|into)\\s+(?:\\w+\\s+)?${target}'s\\s+(?:${bodyPartList})\\b`, "i"),

      // Target cries out in pain
      new RegExp(`\\b${target}\\b(?:\\s+\\w+){0,2}\\s+(?:cry|cries|cried|crying|screams|screaming|yells|yelling|welps|welping)\\s+out(?:\\s+\\w+){0,3}\\s+in\\s+(?:pain|agony)\\b`, "i"),

      // Target clutches their body
      new RegExp(`\\b${target}\\b(?:\\s+\\w+){0,2}\\s+(?:clutch|clutches|clutched|clutching)(?:\\s+\\w+){0,3}\\s+(?:his|her|their|your)\\s+(?:bleeding|wounded|injured|hurt)?\\s*(?:${bodyPartList})\\b`, "i")
    ],

    4: [
      // Blasting, fracturing, impaling, ripping, shredding, etc.
      new RegExp(`\\b(?:blasts|blasted|blasting|explodes|exploding|fractures|fractured|fracturing|impale|impales|impaled|impaling|pierce|pierces|pierced|piercing|rip|rips|ripped|ripping|shred|shreds|shredded|shredding|tear into|tears into|tearing into|tore|torn)(?:\\s+\\w+){0,3}\\s+${target}(?:\\s+\\w+){0,5}\\s+(?:${bodyPartList})\\b`, "i"),

      // Gouging target's body
      new RegExp(`\\b(?:gouge|gouges|gouging)(?:\\s+\\w+){0,3}\\s+${target}'s\\s+(?:${bodyPartList})\\b`, "i"),

      // Target collapses or crumples
      new RegExp(`\\b${target}(?:\\s+\\w+){0,3}\\s+(?:collapse|collapses|collapsed|collapsing|crumple|crumpled|crumples|crumpling)\\b`, "i")
    ],

    5: [
      // Crushing, demolishing, devastating, obliterating, etc.
      new RegExp(`\\b(?:crush|crushes|crushed|crushing|demolish|demolishes|demolished|demolishing|devastate|devastates|devastated|devastating|obliterate|obliterates|obliterated|obliterating|rupture|ruptures|ruptured|rupturing|shatter|shatters|shattered|shattering|splinter|splinters|splintered|splintering)(?:\\s+\\w+){0,3}\\s+${target}(?:\\s+\\w+){0,5}\\s+(?:${bodyPartList})\\b`, "i")
    ]
  };
}

// Apply damage when a hurt pattern is detected
function TestHurt(plr, text, tier) {
  let playerCount = GetPlayerCount();
  let target;

  // Single-player: match you or your
  if (playerCount === 1) {
    target = "(?:you|your)";
  }
  // Multiplayer: match the player's name or possessive name
  else {
    target = `(?:${plr}|${plr}'s)`;
  }

  // Create patterns using the appropriate target
  let hurtRegexs = CreateHurtRegexs(target);

  let matchedPattern = hurtRegexs[tier].find(pattern => pattern.test(text));
  if (!matchedPattern) return false;

  let [minDmg, maxDmg] = damageTiers[tier];
  let dmg = -1 * RandomFloat(minDmg, maxDmg);

  // Calculate damage reduction from DEF
  let defense = state.players[plr].stats.def.current;
  let damageReduction = 0;

  if (defense <= 100) {
    damageReduction = defense / 200;
  } else {
    damageReduction = -0.25 + 0.161 * Math.log(defense);
  }

  // Apply damage reduction
  let finalDmg = dmg * (1 - damageReduction);

  // Apply hurt
  AddStat(plr, "hp", finalDmg, "Injured");

  // Get matching text
  let matchText = text.match(matchedPattern) || [""];
  let msg =
    `Log ${state.turnCount} | Dmg Reason 🩸: ${matchText[0]}\n` +
    `Log ${state.turnCount} | DEF Dmg Reduction 🛡️: ${(damageReduction * 100).toFixed(2)}% (${dmg.toFixed(2)} → ${finalDmg.toFixed(2)})`;

  AddSCDescription(`${plr} Stats`, msg);

  // Getting hurt increases DEF
  AddStat(plr, "def", RandomFloat(0.01, 1), "Injury Exp");

  StoreStatsToSC();

  return true;
}

// Detect hurt words and apply damage to the appropriate players
function ProcessHurt(text) {
  GetPlayerList().forEach(plr => {
    // Check highest damage tier first; apply damage only once
    let tiers = Object.keys(damageTiers)
      .map(Number)
      .sort((a, b) => b - a);

    for (let tier of tiers) {
      TestHurt(plr, text, tier)
    }
  });

  return text;
}

