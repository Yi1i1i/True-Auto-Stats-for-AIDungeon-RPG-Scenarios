////////////////////////////////////////////////////////////////////////////////////
// SCRIPT HOOKS
/////////////////////////////////////////////////////////////////////////////////////

// LIBRARY HOOK
function OnLibrary_TAS() {

  // Initialize undefined state variables
  InitializeState("contextAppendment", "");
  InitializeState("askEnergyCost", {});
  InitializeState("inputCount", 0);
  InitializeState("inputText", "");
  InitializeState("msgHolder", "");
  InitializeState("players", {});
  InitializeState("turnCount", 0);

  InitializeState("settings",
    {
      scriptEnabled: ENABLE_TAS,
      statsToContext: INJECT_STATS_TO_CONTEXT,
    }
  );



  log("state.settings.scriptEnabled: " + state.settings.scriptEnabled);

  CreateIfNoSettingsSC();
  RetrieveSettingsFromSC();
  StoreSettingsToSC();

  DefaultPlrCreation();
}

// INPUT HOOK
function OnInput_TAS(text) {
  text = CheckScriptLock_TAS(text);

  state.inputText = text;

  if (!state.settings.scriptEnabled) {
    return text;
  }

  state.inputCount += 1;
  log("state.inputCount: " + state.inputCount);

  text = AddPlrCmdInput(text);
  text = RemovePlrCmdInput(text);
  text = ListPlrCmdInput(text);

  CreateIfNoStatSC();
  RetrieveStatsFromSC();

  CreateIfNoModifierSC();
  RetrieveModifiersFromSC();

  CreateIfNoInvSC();
  RetrieveInvFromSC();

  CreateIfNoTalentSC();
  RetrieveTalentsFromSC();

  CreateIfNoSkillSC();
  RetrieveSkillsFromSC();


  text = ProcessStorageAction(text);

  text = ProcessGiving(text);

  text = ProcessAttack(text);

  text = ProcessDodge(text);

  text = ProcessScout(text);

  text = ProcessDefend(text);

  text = ProcessExercise(text);

  text = ProcessPraying(text);

  text = ProcessResting(text);

  text = ProcessConsumption(text);

  text = ProcessTalentLearning(text);

  text = WarnPlayerHealth(text);

  text = RewardSkillForLevelUp(text);

  return text;
}

// CONTEXT HOOK
function OnContext_TAS(text) {
  if (!state.settings.scriptEnabled) {
    return text;
  }

  text = PlayerDataToContext(text);

  text = AppendToContext(text);

  text = RemoveAngleText(text);

  //log(text);

  return text;
}

// OUTPUT HOOK
function OnOutput_TAS(text) {
  text = TASHelperCenter(text);

  if (!state.settings.scriptEnabled || info.actionCount < 0) {
    return text;
  }

  CreateIfNoStatSC();
  RetrieveStatsFromSC();

  CreateIfNoModifierSC();
  RetrieveModifiersFromSC()

  CreateIfNoInvSC();
  RetrieveInvFromSC();

  CreateIfNoTalentSC();
  RetrieveTalentsFromSC();

  CreateIfNoSkillSC();
  RetrieveSkillsFromSC();

  // Output functions
  PlayerNaturalRegen();
  text = ProcessHurt(text);
  StoreStatsToSC();

  text = GetLearnedTalentCost(text);
  StoreTalentsToSC();

  StoreSkillsToSC();

  text = ProcessStoring(text);
  StoreInvToSC();

  StoreModifiersToSC();

  SkillUpgradeCheck();
  TalentUpgradeCheck();

  UpdateStateMessage();
  SCLogSeparator();

  TurnCounter();

  state.inputText = "";

  return text;
}

