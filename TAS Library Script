// STORE data in sc so player can see it
function StoreStatsToSC() {
  GetPlayerList().forEach(plr => {
    let plrStats = state.players[plr].stats;

    // Format player stats holder for SC
    let entryHolder = [];

    // Store the player's race and class and level
    entryHolder.push(`Race: ${CapitalizeFirst(state.players[plr].race)}\n`);
    entryHolder.push(`Class: ${CapitalizeFirst(state.players[plr].class_)}\n`);
    entryHolder.push(`LVL ${plrStats.lvl.max}\n`);

    // Sort stats by their order value
    let sortedStats = Object.entries(plrStats)
      .filter(([stat]) => stat !== "lvl")
      .sort((a, b) => a[1].order - b[1].order);

    // Loop through each stat
    for (let [stat, values] of sortedStats) {
      let currentValue = RoundFloat(values.current, 2);
      let maxValue = RoundFloat(values.max, 2);
